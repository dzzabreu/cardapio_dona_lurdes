<!DOCTYPE html>
<html lang="pt-BR">

<head>
    <meta charset="UTF-8">
    <title>Cadastrar Doce</title>
</head>

<body>
    <h1>Cadastrar Novo Doce</h1>

    <form action="/doces" method="POST">
        <div>
            <label for="nome">Nome do Doce:</label><br>
            <input type="text" id="nome" name="nome" required placeholder="Ex: Brigadeiro">
        </div>
        <br>
        <div>
            <label for="preco">Preço (R$):</label><br>
            <input type="number" id="preco" name="preco" step="0.01" required placeholder="Ex: 3.50">
        </div>
        <br>
        <button type="submit">Salvar</button>
        <a href="/doces">Cancelar</a>
    </form>
</body>

</html>